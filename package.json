{
  "name": "micheal",
  "private": true,
  "version": "0.1.0",
  "description": "Micheal — Jarvis-like trading companion (PC desktop + Germany cloud brain)",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:desktop": "pnpm --filter @micheal/desktop dev",
    "dev:electron": "pnpm --filter @micheal/desktop dev:electron",
    "dev:server": "pnpm --filter @micheal/server dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "pack:desktop": "pnpm --filter @micheal/desktop pack",
    "start:server": "pnpm --filter @micheal/server start"
  },
  "license": "MIT"
}
