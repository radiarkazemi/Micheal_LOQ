{
  "name": "@micheal/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5174 --host 127.0.0.1",
    "dev:electron": "concurrently -k -n vite,electron -c cyan,magenta \"vite --port 5174 --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "pack": "pnpm build && electron-builder --config electron-builder.yml",
    "electron": "electron ."
  },
  "dependencies": {
    "@micheal/protocol": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
